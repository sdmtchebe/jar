# Workspace folders Jarvis may access. Separate multiple folders with ':' on macOS/Linux.
JARVIS_MODEL_ENDPOINTS='[{"name":"primary","base_url":"https://api.example.com/v1","model":"open-source-model","api_key_env":"JARVIS_PRIMARY_API_KEY"}]'
JARVIS_WORKSPACE_ROOTS=/workspace/jar
JARVIS_REQUIRE_CONFIRMATION=true
JARVIS_EMAIL_PROVIDER=dry-run
JARVIS_SMS_PROVIDER=dry-run

# Add your own OpenAI-compatible cloud model endpoints here.
# api_key_env is the NAME of the environment variable that stores the secret key.
JARVIS_MODEL_ENDPOINTS='[{"name":"openrouter","base_url":"https://openrouter.ai/api/v1","model":"meta-llama/llama-3.1-8b-instruct:free","api_key_env":"OPENROUTER_API_KEY"}]'
OPENROUTER_API_KEY="replace-with-your-real-key"

# Add more providers/models by adding objects to the JSON array, for example:
# JARVIS_MODEL_ENDPOINTS='[{"name":"openrouter","base_url":"https://openrouter.ai/api/v1","model":"meta-llama/llama-3.1-8b-instruct:free","api_key_env":"OPENROUTER_API_KEY"},{"name":"together","base_url":"https://api.together.xyz/v1","model":"meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo","api_key_env":"TOGETHER_API_KEY"}]'
# TOGETHER_API_KEY="replace-with-your-real-key"
